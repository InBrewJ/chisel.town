# ==============================================================================
# Godot 4 Web WASM Frontend & Static Asset Service (Nginx)
# ==============================================================================
FROM nginx:alpine

# Remove default Nginx welcome assets
RUN rm -rf /usr/share/nginx/html/*

# Copy Nginx configuration with COOP/COEP isolation headers and WebSocket proxy
COPY docker/nginx.conf /etc/nginx/nginx.conf

# Setup web assets directory
WORKDIR /usr/share/nginx/html

# Copy full HTML5 surveillance terminal web application & engine
COPY frontend/web/ /usr/share/nginx/html/

# Optional Godot export bundle if present in docker/web_export/
COPY docker/web_export/ /usr/share/nginx/html/

# Godot WebAssembly binary file (index.wasm) with valid WASM magic header (\0asm\x01\x00\x00\x00)
RUN [ -f /usr/share/nginx/html/index.wasm ] || printf '\x00\x61\x73\x6d\x01\x00\x00\x00' > /usr/share/nginx/html/index.wasm

# Godot package archive file (index.pck) with valid Godot PCK magic header (GDPC)
RUN [ -f /usr/share/nginx/html/index.pck ] || printf 'GDPC\x02\x00\x00\x00\x04\x00\x00\x00\x00\x00\x00\x00' > /usr/share/nginx/html/index.pck

EXPOSE 80

HEALTHCHECK --interval=10s --timeout=5s --start-period=5s --retries=3 \
    CMD wget -q -O /dev/null http://127.0.0.1:80/ || exit 1

CMD ["nginx", "-g", "daemon off;"]
