#!/usr/bin/env python
import os
import sys

# Standard SCons build script for Godot 4 GDExtension module (swarm_core)

vars = Variables("custom.py")
vars.Add(EnumVariable("target", "Compilation target", "template_debug", ["template_debug", "template_release", "debug", "release"]))
vars.Add(EnumVariable("platform", "Target platform", sys.platform, ["linux", "windows", "macos", "web"]))
vars.Add(BoolVariable("use_llvm", "Use LLVM/Clang compiler", False))
vars.Add(BoolVariable("use_static_cpp", "Link libgcc/libstdc++ statically", False))
vars.Add(BoolVariable("dev_build", "Developer build with extra debug info", False))
vars.Add(PathVariable("godot_cpp_path", "Path to godot-cpp", "godot-cpp", PathVariable.PathAccept))

env = Environment(variables=vars)

# Resolve target platform
target = env.get("target", "template_debug")
platform = env.get("platform", "linux")
if platform.startswith("linux"):
    platform = "linux"
elif platform.startswith("win"):
    platform = "windows"
elif platform.startswith("darwin"):
    platform = "macos"

# Standard C++ flags (GDExtension requires C++17 or newer)
env.Append(CXXFLAGS=["-std=c++17", "-O2"])
env.Append(CPPDEFINES=["GODOT_GDEXTENSION"])

# godot-cpp include paths
godot_cpp_path = env.get("godot_cpp_path", "godot-cpp")
env.Append(CPPPATH=[
    ".",
    os.path.join(godot_cpp_path, "include"),
    os.path.join(godot_cpp_path, "gen", "include"),
    os.path.join(godot_cpp_path, "gdextension"),
])

# Source files
sources = [
    "register_types.cpp",
    "swarm_lattice.cpp",
]

# Output binary configuration
output_dir = os.path.join("..", "bin")
lib_name = "libswarm_core.{0}.{1}".format(platform, target)

if platform == "linux":
    env.Append(CCFLAGS=["-fPIC"])
    env.Append(LINKFLAGS=["-shared"])
    shared_lib = env.SharedLibrary(
        target=os.path.join(output_dir, lib_name + ".x86_64.so"),
        source=sources
    )
elif platform == "windows":
    shared_lib = env.SharedLibrary(
        target=os.path.join(output_dir, lib_name + ".x86_64.dll"),
        source=sources
    )
elif platform == "web":
    env.Append(LINKFLAGS=["-sSIDE_MODULE=1"])
    shared_lib = env.SharedLibrary(
        target=os.path.join(output_dir, lib_name + ".wasm32.wasm"),
        source=sources
    )
else:
    shared_lib = env.SharedLibrary(
        target=os.path.join(output_dir, lib_name),
        source=sources
    )

Default(shared_lib)
